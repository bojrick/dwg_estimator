[Unit]
Description=Plan Vault PWA FastAPI Backend Service
After=network.target

[Service]
Type=simple
User=planvault
Group=www-data
WorkingDirectory=/opt/dwg_estimator/backend

# Environment & Dependencies
Environment="PATH=/opt/dwg_estimator/backend/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="HOME=/tmp"
Environment="MALLOC_ARENA_MAX=2"
EnvironmentFile=/opt/dwg_estimator/backend/.env

# 2 Gunicorn workers to leave memory headroom for LibreDWG dwg2dxf subprocesses
ExecStart=/opt/dwg_estimator/backend/.venv/bin/gunicorn \
    -w 2 \
    -k uvicorn.workers.UvicornWorker \
    --bind 127.0.0.1:8000 \
    --timeout 300 \
    --graceful-timeout 30 \
    --max-requests 300 \
    --max-requests-jitter 50 \
    --access-logfile - \
    --error-logfile - \
    app.main:app

# Process supervision & auto-restart
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30

# Security sandboxing
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/dwg_estimator/storage

# Resource limits (prevent runaway CAD parsing memory leak)
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

