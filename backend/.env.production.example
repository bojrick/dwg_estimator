# ==============================================================================
# Plan Vault PWA - Production Environment Configuration
# ==============================================================================
# Copy this file to .env on your Linux VPS:
#   cp .env.production.example .env
#   chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Security & Authentication (CRITICAL)
# ------------------------------------------------------------------------------
# Generate a strong 64-character hex secret for signing JWT auth tokens:
#   Run in VPS terminal: openssl rand -hex 32
AUTH_SECRET_KEY=replace-with-a-secure-random-64-character-hex-secret-key

# Allowed CORS origins (comma-separated). Set to your domain.
# In production behind Nginx reverse proxy, frontend and backend share the same domain.
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ------------------------------------------------------------------------------
# 2. Storage & Database
# ------------------------------------------------------------------------------
# Persistent storage directory for CAD drawings, parsed JSON, and SQLite database.
STORAGE_DIR=/opt/dwg_estimator/storage

# Database connection:
# - Leave blank to use fast local SQLite at $STORAGE_DIR/plan_vault.db (recommended for single VPS)
# - Or provide PostgreSQL connection string: postgresql://user:password@localhost:5432/planvault
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Optional: Cloudflare R2 Object Storage
# ------------------------------------------------------------------------------
# If left blank, Plan Vault automatically stores all drawings locally in $STORAGE_DIR/cloud
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# ------------------------------------------------------------------------------
# 4. Optional: Supabase Auth Integration
# ------------------------------------------------------------------------------
# Only needed if you are using Supabase Auth instead of native FOSS auth
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

