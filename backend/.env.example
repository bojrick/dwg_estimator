# Supabase Auth & Postgres Database Configuration
# Find these in Supabase Dashboard -> Project Settings -> API & Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Optional: JWT Secret for zero-latency local HS256 token verification
SUPABASE_JWT_SECRET=
# Optional: Supabase Postgres connection URI (falls back to local SQLite if blank)
DATABASE_URL=

# Cloudflare R2 Object Storage Configuration
# Find your Account ID in Cloudflare Dashboard -> R2 Overview
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional custom domain or public bucket URL (e.g., https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=
